# TrailWeave Configuration

# Supabase PostgreSQL Configuration
# Paste your Supabase Connection String (Direct or Transaction Pooler):
# Async driver format (used by FastAPI async engine):
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Sync driver format (used by schema migration scripts if needed):
SYNC_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# API Settings
PROJECT_NAME="TrailWeave API"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PORT=8000

# Optional Google Gemini & Maps API Keys
GEMINI_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Authentication & Security Secrets (Required)
JWT_SECRET_KEY=""
PIN_HASH_SALT=""
PASSWORD_HASH_SALT=""

# Meta WhatsApp Webhook Verification
WHATSAPP_VERIFY_TOKEN=""
